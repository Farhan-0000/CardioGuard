# =============================================================================
# MedBridge configuration template (copy to .env; never commit .env)
# =============================================================================
# Create your real .env with:
#
#     python scripts/setup_env.py
#
# It copies this file to .env and fills the four empty secrets below
# (ENCRYPTION_MASTER_KEY, SESSION_TOKEN_SECRET, ADMIN_PASSWORD, POSTGRES_PASSWORD)
# with freshly generated random values, then rewrites DATABASE_URL so it uses
# POSTGRES_PASSWORD. Existing values are never overwritten (use --force to
# regenerate them).
#
# Format rules: one KEY=value per line, no spaces around "=", no inline
# comments after a value, booleans are true/false. Environment variables set in
# your shell override the values in .env. Every key has the same default in
# medbridge/config.py; HOW_TO_RUN.md explains each one.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM inference (local Ollama by default; nothing leaves the machine)
# -----------------------------------------------------------------------------
# ollama | groq | openai (groq/openai are optional and ignored while LOCAL_ONLY_MODE=true)
LLM_PROVIDER=ollama
# true = remote providers are never contacted and only a loopback Ollama host is allowed
LOCAL_ONLY_MODE=true
# Native Ollama endpoint (a trailing /v1 is tolerated)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Application model for the extractor, both gates and the generator.
# qwen3.5:4b was chosen on the dev split of the model-selection experiment
# (evaluation/results/model_selection/) and fits a 6 GB GPU. Fallback: gemma3:4b
LLM_MODEL=qwen3.5:4b
# Optional per-role overrides (empty = use LLM_MODEL)
LLM_MODEL_GATES=
LLM_MODEL_GENERATOR=
# How long Ollama keeps the model in (V)RAM after the last request
LLM_KEEP_ALIVE=30m
# Context window in tokens. Lower it only if Ollama runs out of memory (keep >= 6144)
LLM_NUM_CTX=8192
# Keep false: disables "thinking" traces of hybrid reasoning models (qwen3 / qwen3.5)
LLM_THINK=false
# Seconds per LLM request before it counts as failed (the pipeline then degrades safely)
LLM_TIMEOUT=120.0
# Gates run deterministically (architecture invariant: temperature 0.0, seed 42)
LLM_TEMPERATURE_GATES=0.0
LLM_TEMPERATURE_GENERATOR=0.3
LLM_MAX_TOKENS_GATES=512
LLM_MAX_TOKENS_GENERATOR=900
LLM_SEED=42
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0
# Optional remote providers (only used with LOCAL_ONLY_MODE=false and LLM_PROVIDER=groq/openai)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16 from docker-compose.yml, host port 5433, loopback only)
# -----------------------------------------------------------------------------
# Generated by scripts/setup_env.py. Used by docker compose when the database
# volume is FIRST created; changing it later does not change the stored password.
POSTGRES_PASSWORD=
# The password part is replaced by scripts/setup_env.py (the placeholder below must not be used)
DATABASE_URL=postgresql+asyncpg://medbridge_app:change-me@127.0.0.1:5433/medbridge
# Optional: separate database for live benchmarks and the hallucination study
# (create it first, see HOW_TO_RUN.md). Read by the benchmark runners and
# scripts/run_study.sh; evaluation.run reads it from the shell environment.
# EVAL_DATABASE_URL=postgresql+asyncpg://medbridge_app:<POSTGRES_PASSWORD>@127.0.0.1:5433/medbridge_eval

# -----------------------------------------------------------------------------
# Vector store and retrieval (Qdrant from docker-compose.yml, port 6333)
# -----------------------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=clinical_guidelines
# Hybrid dense + BM25 candidates fused with RRF (k=60), then cross-encoder top-k
RETRIEVAL_TOP_K_CANDIDATES=20
RETRIEVAL_TOP_K_RERANKED=5
# Changing an embedding model requires re-indexing: python -m medbridge.ingestion --recreate
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# In-process cache of query embeddings and retrieval results
RETRIEVAL_CACHE_SIZE=512
RETRIEVAL_CACHE_TTL_SECONDS=900
# Start retrieval concurrently with Gate 1; the result is discarded on SOFT-ASK
SPECULATIVE_RETRIEVAL=true
# Characters of each evidence chunk passed to the LLM prompts
EVIDENCE_MAX_CHARS_PER_CHUNK=2400

# -----------------------------------------------------------------------------
# Pipeline safety behaviour
# -----------------------------------------------------------------------------
# Soft-ask loop-breaker threshold (architecture invariant: keep 2)
SOFT_ASK_MAX_COUNT=2
# Previous turns given to the Context Extractor (coreference: "is that dose ok?")
EXTRACTOR_HISTORY_TURNS=4
# Strip citation markers that do not map to a retrieved chunk
CITATION_VALIDATION_ENABLED=true
# Deterministic replies to greetings/thanks (no clinical claims)
SMALL_TALK_ENABLED=true
# V1 calibrated Evidence Gate (off by default). Thresholds come from
# evaluation/results/calibration.json after `python -m evaluation.calibrate`.
EVIDENCE_GATE_CALIBRATION_ENABLED=false
EVIDENCE_GATE_VOTES=3
EVIDENCE_MIN_RERANK_ANSWER=0.0
EVIDENCE_MIN_RERANK_ANY=-6.0
EVIDENCE_MIN_ENTITY_COVERAGE=0.0
# V2 post-generation Grounding Verifier ("Gate 3", off by default; downloads an NLI model)
GROUNDING_VERIFIER_ENABLED=false
GROUNDING_NLI_MODEL=cross-encoder/nli-MiniLM2-L6-H768
GROUNDING_ENTAILMENT_THRESHOLD=0.5
GROUNDING_MAX_UNSUPPORTED_FRACTION=0.34
# Load embedders, reranker and the Ollama model in the background at start-up
WARMUP_ON_STARTUP=true

# -----------------------------------------------------------------------------
# Privacy and security
# -----------------------------------------------------------------------------
# Redact names, phone numbers, e-mails, IDs, addresses, exact birth dates before any LLM call/storage
PII_REDACTION_ENABLED=true
# Field-level encryption at rest (per-session data keys wrapped by the master key)
ENCRYPTION_ENABLED=true
# Fernet key (32 random bytes, urlsafe base64). Generated by scripts/setup_env.py.
# Losing it makes every stored conversation unreadable.
ENCRYPTION_MASTER_KEY=
# HMAC secret for signed session and admin tokens. Generated by scripts/setup_env.py.
SESSION_TOKEN_SECRET=
# Session token lifetime in seconds (7 days)
SESSION_TOKEN_TTL_SECONDS=604800
# Require the signed bearer token on every session route
AUTH_REQUIRED=true
# Admin dashboard login at /dashboard (empty ADMIN_PASSWORD disables the login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Message requests per minute per client IP (0 disables the limit)
RATE_LIMIT_PER_MINUTE=30
# Maximum request body size in bytes
MAX_REQUEST_BYTES=32768
# Sessions older than this are purged by the background retention job
DATA_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Server and UI
# -----------------------------------------------------------------------------
# Loopback only. Do not use 0.0.0.0 unless you deliberately expose the API to your network.
HOST=127.0.0.1
PORT=8000
# JSON list of browser origins allowed to call the API
CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000","http://127.0.0.1:8501","http://localhost:8501"]
APP_NAME=MedBridge
# Shown on the ESCALATE emergency card (India defaults; e.g. 911 / United States)
EMERGENCY_NUMBER=112
AMBULANCE_NUMBER=108
EMERGENCY_REGION_LABEL=India
