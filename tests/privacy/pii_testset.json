{
  "name": "MedBridge synthetic PII/PHI redaction test set",
  "version": "1.1",
  "created": "2026-10-09",
  "description": "Fully synthetic patient-style messages (Indian + US formats). All names, numbers and addresses are invented; phone numbers use fictional ranges where possible. Authored before the detector was implemented. Includes deliberately out-of-scope cases (names with no contextual cue) so recall is not overstated.",
  "conventions": {
    "NAME": "person-name tokens only; titles (Mr./Dr.) and cue words excluded",
    "PHONE": "full number incl. country code / trunk prefix and internal separators; label excluded",
    "EMAIL": "full address",
    "URL": "full URL without trailing punctuation",
    "IP": "IPv4 / IPv6 address (an IP inside a URL counts as URL only)",
    "AADHAAR|PAN|SSN|MRN|INSURANCE_ID": "identifier value only, label excluded",
    "ADDRESS": "from the house/flat cue or house number through street, locality, city and state; PIN/ZIP excluded",
    "PINCODE": "6-digit Indian PIN or US ZIP value only",
    "AGE": "the exact date-of-birth expression only (replaced by [AGE: N]); year-only mentions are not redacted",
    "protected": "substrings that must survive redaction unchanged (clinical values, drug names, doses, ages)",
    "negatives": "kind=negative examples contain no PII; the redacted text must equal the input exactly"
  },
  "splits": {
    "dev": "authored together with the detector (in-sample)",
    "heldout": "authored after the detector was frozen; never used for tuning"
  },
  "examples": [
