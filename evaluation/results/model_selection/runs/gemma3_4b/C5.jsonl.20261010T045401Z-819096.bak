{"run_id": "20261009T164418Z-288605", "attempt_id": "7ec9fbcf02fd4f98830a5a25d166eac3", "condition": "C5", "item_id": "HB-0008", "category": "answerable_complete", "subcategory": "medication_class", "split": "dev", "style": "clinical", "turn_index": 0, "n_turns": 1, "user_text": "Which drug classes does WHO recommend as first-line for an adult with hypertension who needs medication?", "gold_action": "ANSWER", "acceptable_actions": ["ANSWER", "GENERALIZE"], "session_id": "9f4bf497-3d46-4f84-8ef8-1367da011a5a", "action": "ANSWER", "response_text": "WHO recommends the use of drugs from three classes as a first-line treatment for adults with hypertension [1][2]. These classes are thiazide and thiazide-like agents, angiotensin-converting enzyme inhibitors (ACEis)/angiotensin-receptor blockers (ARBs), and long-acting dihydropyridine calcium channel blockers (CCBs) [1]. The guidelines suggest using these medications to prevent cardiovascular disease [3].", "citations": [{"marker": "[1]", "chunk_id": "who_htn_pharm_2021_p13_c24", "source": "WHO 2021", "section": "Scope and objectives of the hypertension guideline", "excerpt": "Scope and objectives of the hypertension guideline The 2021 WHO hypertension guideline aims to provide the most current and relevant evidencebased global public health guidance on the initiation of treatment (with pharmacological agents) for hypertension in adults. The recommendations target the general adult, non-pregnant, hypertensive…", "guideline_id": "WHO_HTN_PHARM_2021", "title": "Guideline for the pharmacological treatment of hypertension in adults", "org": "WHO", "year": 2021, "page": 13, "url": "https://iris.who.int/handle/10665/344424"}, {"marker": "[2]", "chunk_id": "aha_acc_htn_2025_p36_c142", "source": "AHA/ACC 2025", "section": "5.2. Medical Management > Recommendation-Specific Supportive Text", "excerpt": "5.2. Medical Management > Recommendation-Specific Supportive Text | Recommendation for Initial Medication Selection for Treatment of Primary Hypertension Referenced studies that support the recommendation are summarized in the Evidence Table. | | | | --- | --- | --- | | COR | LOE | Recommendation | | 1 | A | 1. For adults initiating…", "guideline_id": "AHA_ACC_HTN_2025", "title": "2025 AHA/ACC/AANP/AAPA/ABC/ACCP/ACPM/AGS/AMA/ASPC/NMA/PCNA/SGIM Guideline for the Prevention, Detection, Evaluation and Management of High Blood Pressure in Adults", "org": "AHA/ACC", "year": 2025, "page": 36, "url": "https://doi.org/10.1161/CIR.0000000000001356"}, {"marker": "[3]", "chunk_id": "who_htn_pharm_2021_p10_c17", "source": "WHO 2021", "section": "4. RECOMMENDATION ON DRUG CLASSES TO BE USED AS FIRST-LINE AGENTS", "excerpt": "4. RECOMMENDATION ON DRUG CLASSES TO BE USED AS FIRST-LINE AGENTS For adults with hypertension requiring pharmacological treatment, WHO recommends the use of drugs from any of the following three classes of pharmacological antihypertensive medications as an initial treatment: 1. thiazide and thiazide-like agents 2. angiotensin-converting enzyme…", "guideline_id": "WHO_HTN_PHARM_2021", "title": "Guideline for the pharmacological treatment of hypertension in adults", "org": "WHO", "year": 2021, "page": 10, "url": "https://iris.who.int/handle/10665/344424"}], "explanation": {"gate1": {"action": "PROCEED", "rationale": "The question asks for a list of recommended medications, which is general information.", "missing_fields": [], "source": "llm", "votes": [], "features": {}}, "gate2": {"action": "ANSWER", "rationale": "Chunk 1 and 3 directly state the WHO's recommendation for first-line drug classes for hypertension.", "missing_fields": [], "source": "llm", "votes": [], "features": {"max_rerank": 8.818610191345215, "mean_top3_rerank": 7.855343500773112, "entity_coverage": 1.0, "n_chunks": 5.0}}, "gate3": null, "emergency": {"action": null, "matched_rules": [], "negated": [], "suppressed": [], "bp": null}, "retrieval": [{"rank": 1, "chunk_id": "who_htn_pharm_2021_p10_c17", "guideline_id": "WHO_HTN_PHARM_2021", "title": "Guideline for the pharmacological treatment of hypertension in adults", "org": "WHO", "year": 2021, "section": "4. RECOMMENDATION ON DRUG CLASSES TO BE USED AS FIRST-LINE AGENTS", "page": 10, "score_rrf": 0.031498015, "score_rerank": 8.818610191345215, "excerpt": "4. RECOMMENDATION ON DRUG CLASSES TO BE USED AS FIRST-LINE AGENTS For adults with hypertension requiring pharmacological treatment, WHO recommends the use of drugs from any of the following three classes of pharmacological antihypertensive medications as an initial treatment: 1. thiazide and…", "cited": true}, {"rank": 2, "chunk_id": "who_htn_pharm_2021_p13_c24", "guideline_id": "WHO_HTN_PHARM_2021", "title": "Guideline for the pharmacological treatment of hypertension in adults", "org": "WHO", "year": 2021, "section": "Scope and objectives of the hypertension guideline", "page": 13, "score_rrf": 0.032539684, "score_rerank": 7.435206413269043, "excerpt": "Scope and objectives of the hypertension guideline The 2021 WHO hypertension guideline aims to provide the most current and relevant evidencebased global public health guidance on the initiation of treatment (with pharmacological agents) for hypertension in adults. The recommendations target the…", "cited": true}, {"rank": 3, "chunk_id": "aha_acc_htn_2025_p36_c142", "guideline_id": "AHA_ACC_HTN_2025", "title": "2025 AHA/ACC/AANP/AAPA/ABC/ACCP/ACPM/AGS/AMA/ASPC/NMA/PCNA/SGIM Guideline for the Prevention, Detection, Evaluation and Management of High Blood Pressure in Adults", "org": "AHA/ACC", "year": 2025, "section": "5.2. Medical Management > Recommendation-Specific Supportive Text", "page": 36, "score_rrf": 0.031513646, "score_rerank": 7.312213897705078, "excerpt": "5.2. Medical Management > Recommendation-Specific Supportive Text | Recommendation for Initial Medication Selection for Treatment of Primary Hypertension Referenced studies that support the recommendation are summarized in the Evidence Table. | | | | --- | --- | --